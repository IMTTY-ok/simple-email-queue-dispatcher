# Point the deployed frontend at the deployed Firebase Cloud Functions API.
# Leave unset locally — the Vite dev proxy forwards /api to the Firebase emulator.
# Vercel: add this under Settings -> Environment Variables (Production) and redeploy.
VITE_API_URL=https://us-central1-email-dispatcher-43118.cloudfunctions.net/backend

# Only VITE_-prefixed variables are bundled at build time.
# NEVER put SMTP credentials in a VITE_ variable — they are server-side only.