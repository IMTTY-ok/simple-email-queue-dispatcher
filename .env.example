# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment (Vite) — copy this file to `.env.local` and adjust.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put an SMTP password or a service-account key in a VITE_ variable —
# everything prefixed with VITE_ ships to the client in plain text.
#
# You do NOT need this file for local development: the Vite dev proxy forwards
# /api to the Firebase emulator, and the Firebase project id is read from
# `.firebaserc`. Fill this in when you deploy, or when you want the dashboard
# to talk to your own Firebase project.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Cloud Function that hosts the API.
# Leave unset locally — the Vite dev proxy forwards /api to the emulator.
# Production example:
#   VITE_API_URL=https://us-central1-email-dispatcher-43118.cloudfunctions.net/backend
VITE_API_URL=

# Firebase web configuration (optional).
# These are public client identifiers, not secrets — they are also readable
# from the shipped JavaScript bundle. The security boundary is the Firestore
# rules, not these values.
#
# Where to find them: Firebase console -> Project settings -> Your apps ->
# "SDK setup and configuration" -> Config.
#
# If you leave these empty the dashboard falls back to the demo project, and
# VITE_FIREBASE_PROJECT_ID falls back to the `default` project in `.firebaserc`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
