{
  "name": "email-queue-dispatcher",
  "private": true,
  "version": "1.0.0",
  "description": "A real SMTP email queue dispatcher with a bounded retry engine, live delivery logging and CSV/JSON dispatch reports.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "email-queue",
    "retry-logic",
    "firebase",
    "cloud-functions",
    "nodemailer",
    "smtp",
    "react",
    "typescript",
    "dashboard"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n emu,web -c yellow,cyan \"npm:dev:emulators\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:emulators": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=300 firebase emulators:start --only functions,firestore",
    "dev:setup": "npm install --prefix functions",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint src functions tests scripts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\" \"tests/**/*.test.js\"",
    "test:integration": "node scripts/integration-check.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^11.8.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "firebase-tools": "^13.30.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
