# Local Firebase Emulator environment.
# Copy this file to functions/.env (gitignored) - the emulator reads it automatically.
# For the deployed backend, these same values come from Firebase secrets
# (firebase functions:secrets:set SMTP_PASS ...) or from the dashboard
# (Settings panel -> saved server-side into a rules-protected Firestore doc).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-google-app-password
FROM_EMAIL=you@gmail.com
FROM_NAME=Email Dispatcher

# Retry engine (Module 3): the maximum number of delivery attempts is
# RETRY_LIMIT + 1, so the default of 3 allows 4 attempts in total.
RETRY_LIMIT=3
RETRY_DELAY_MS=3000
INTER_EMAIL_DELAY_MS=1200

# Send Simulator (Module 2): when true no mail server is contacted.
SMTP_DRYRUN=true

# Simulation mode used while dry-run is enabled:
# AUTOMATIC | FORCE_SUCCESS | FORCE_FAILURE
SIMULATION_MODE=AUTOMATIC

# Comma-separated list of browser origins allowed to call the API.
# State-changing requests from any other origin are refused with 403.
# Defaults to the localhost development origins when unset.
ALLOWED_ORIGIN=http://localhost:5173
