# Local Firebase Emulator environment for the Cloud Function.
# Copy this file to functions/.env (gitignored) - the emulator reads it automatically.
#
# For the deployed backend, these same values come from the function's
# environment, Firebase secrets (firebase functions:secrets:set SMTP_PASS ...) or
# from the dashboard (Settings panel -> saved server-side into a rules-protected
# Firestore doc).

# ── SMTP transport (Module 2 — Send Simulator) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-google-app-password
FROM_EMAIL=you@gmail.com
FROM_NAME=Email Dispatcher

# ── Retry engine (Module 3 — Retry Logic Engine) ──────────────────────────────
# The maximum number of delivery attempts is RETRY_LIMIT + 1,
# so the default of 3 allows 4 attempts in total.
RETRY_LIMIT=3
RETRY_DELAY_MS=3000
INTER_EMAIL_DELAY_MS=1200

# ── Simulation (Module 2) ─────────────────────────────────────────────────────
# When true no mail server is contacted.
SMTP_DRYRUN=true
# AUTOMATIC | FORCE_SUCCESS | FORCE_FAILURE
# FORCE_FAILURE is how you demonstrate the retry engine.
SIMULATION_MODE=AUTOMATIC

# ── API hardening ─────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to change state.
# Requests from any other origin are refused with 403.
# Defaults to the localhost development origins when unset.
ALLOWED_ORIGIN=http://localhost:5173

# Rate limit for the state-changing endpoints, per IP.
# The dashboard's dispatch pump calls /api/dispatch/continue roughly every two
# seconds, so keep the limit comfortably above that.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ── Scheduled delivery (Module 6) ─────────────────────────────────────────────
# The scheduled delivery trigger is a Google Cloud Tasks queue. The function
# signs every task payload with SCHEDULE_TASK_SECRET; without a secret
# nothing is ever queued and the feature fails closed.
#
# Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHEDULE_TASK_SECRET=

# The region the task queue lives in. It must be the same region as the
# function that receives the task.
CLOUD_TASKS_LOCATION=us-central1

# The name of the task queue. It is created on demand, but creating it once
# with `gcloud tasks queues create` is recommended:
#   gcloud tasks queues create email-scheduler --location=us-central1
CLOUD_TASKS_QUEUE=email-scheduler

# The full URL of the `scheduledDispatch` function. Only needed when the
# function is not reachable at its default address.
# SCHEDULED_DISPATCH_URL=https://us-central1-<project>.cloudfunctions.net/scheduledDispatch

# A shared secret for the scheduler sweep. A Cloud Scheduler job calls the
# `scheduledSweep` function with it in the `X-Internal-Sweep-Token` header.
SCHEDULE_SWEEP_TOKEN=

# How many due emails one sweep may deliver at once.
SCHEDULE_SWEEP_BATCH=5
