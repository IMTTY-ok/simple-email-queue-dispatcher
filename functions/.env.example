# Local Firebase Emulator environment for the Cloud Function.
# Copy this file to functions/.env (gitignored) - the emulator reads it automatically.
#
# For the deployed backend, these same values come from the function's
# environment, Firebase secrets (firebase functions:secrets:set SMTP_PASS ...) or
# from the dashboard (Settings panel -> saved server-side into a rules-protected
# Firestore doc).

# ── SMTP transport (Module 2 — Send Simulator) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-google-app-password
FROM_EMAIL=you@gmail.com
FROM_NAME=Email Dispatcher

# ── Retry engine (Module 3 — Retry Logic Engine) ──────────────────────────────
# The maximum number of delivery attempts is RETRY_LIMIT + 1,
# so the default of 3 allows 4 attempts in total.
RETRY_LIMIT=3
RETRY_DELAY_MS=3000
INTER_EMAIL_DELAY_MS=1200

# ── Simulation (Module 2) ─────────────────────────────────────────────────────
# When true no mail server is contacted.
SMTP_DRYRUN=true
# AUTOMATIC | FORCE_SUCCESS | FORCE_FAILURE
# FORCE_FAILURE is how you demonstrate the retry engine.
SIMULATION_MODE=AUTOMATIC

# ── API hardening ─────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to change state.
# Requests from any other origin are refused with 403.
# Defaults to the localhost development origins when unset.
ALLOWED_ORIGIN=http://localhost:5173

# Rate limit for the state-changing endpoints, per IP.
# The dashboard's dispatch pump calls /api/dispatch/continue roughly every two
# seconds, so keep the limit comfortably above that.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
